// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String    @db.Text
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model AppSettings {
  id                     Int      @id @default(1)
  shop                   String   @unique
  isActive               Boolean  @default(false)
  isOdooActive           Boolean  @default(true)
  triggerMode            String   @default("ALL_PRODUCTS")
  triggerProductId       String?  @db.Text
  targetProductId        String?  @db.Text
  triggerProductTitle    String?  @db.Text
  targetProductTitle     String?  @db.Text
  discountPercentageProduct Decimal? @default(10.0)
  discountPercentageStore   Decimal? @default(15.0)
  logRetentionDays       Int      @default(30)
  updatedAt              DateTime @updatedAt
}

model Log {
  id              Int      @id @default(autoincrement())
  shop            String
  orderId         String
  customerName    String?
  productCode     String?
  storewideCode   String?
  
  triggerModeUsed          String?
  triggerProductIdUsed     String?  @db.Text
  targetProductIdUsed      String?  @db.Text
  discountPercentageProductUsed Decimal?
  discountPercentageStoreUsed   Decimal?

  createdAt       DateTime @default(now())
}

model AppUser {
  id               Int      @id @default(autoincrement())
  shop             String
  email            String
  password         String
  name             String?
  canViewDashboard Boolean  @default(true)
  canViewLogs      Boolean  @default(true)
  canViewSettings  Boolean  @default(false)
  createdAt        DateTime @default(now())
}

model BackfillRun {
  id              Int      @id @default(autoincrement())
  shop            String
  productId       String   @db.Text
  startDate       DateTime
  endDate         DateTime
  status          String   // PREVIEW, COMPLETED, FAILED
  totalFound      Int      @default(0)
  totalSent       Int      @default(0)
  totalSkipped    Int      @default(0)
  totalFailed     Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  items           BackfillItem[]
}

model BackfillItem {
  id              Int      @id @default(autoincrement())
  backfillRunId   Int
  orderId         String
  status          String   // PENDING, SENT, FAILED, SKIPPED
  errorMessage    String?  @db.Text
  run             BackfillRun @relation(fields: [backfillRunId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}


